{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "handoff-v1/envelope.schema.json",
  "title": "TYPO3 design migration handoff envelope (v1)",
  "type": "object",
  "required": [
    "schemaVersion", "artifactType", "artifactId", "revision", "payloadDigest",
    "readiness", "sources", "dependencies", "target", "evidence",
    "verification", "decisions", "unresolved", "payload"
  ],
  "properties": {
    "schemaVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "artifactType": { "enum": ["design-system", "component-spec", "build-report"] },
    "artifactId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "revision": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "payloadDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "generatedAt": { "type": "string" },
    "readiness": { "enum": ["ready", "incomplete", "blocked"] },
    "sources": { "type": "array", "items": { "$ref": "#/$defs/source" } },
    "dependencies": { "type": "array", "items": { "$ref": "#/$defs/dependency" } },
    "target": {
      "type": "object",
      "required": ["versionsKnown"],
      "properties": {
        "versionsKnown": { "type": "boolean" },
        "typo3": { "type": "string" },
        "php": { "type": "string" },
        "astryx": { "type": "string" },
        "styleXConnector": { "type": "string" },
        "conflicts": { "type": "array", "items": { "type": "string" } }
      }
    },
    "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } },
    "verification": { "type": "array", "items": { "$ref": "#/$defs/verification" } },
    "decisions": { "type": "array", "items": { "$ref": "#/$defs/decision" } },
    "unresolved": { "type": "array", "items": { "$ref": "#/$defs/unresolved" } },
    "payload": { "type": "object" }
  },
  "$defs": {
    "source": {
      "type": "object",
      "required": ["kind", "locator", "identityStatus"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "locator": { "type": "string", "minLength": 1 },
        "selector": { "type": "string" },
        "identityStatus": { "enum": ["known", "unavailable"] },
        "digest": { "type": "string" },
        "revision": { "type": "string" }
      }
    },
    "dependency": {
      "type": "object",
      "required": ["artifactType", "artifactId", "schemaVersion", "revision", "ref"],
      "properties": {
        "artifactType": { "enum": ["design-system", "component-spec", "build-report"] },
        "artifactId": { "type": "string", "minLength": 1 },
        "schemaVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "revision": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "ref": { "type": "string", "minLength": 1 }
      }
    },
    "evidence": {
      "type": "object",
      "required": ["id", "class", "kind"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "class": { "enum": ["observed", "inferred", "unknown"] },
        "kind": { "type": "string", "minLength": 1 },
        "locator": { "type": "string" },
        "note": { "type": "string" }
      }
    },
    "verification": {
      "type": "object",
      "required": ["id", "status", "reason"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "status": { "enum": ["passed", "failed", "not-run", "not-applicable"] },
        "reason": { "type": "string", "minLength": 1 },
        "command": { "type": "string" },
        "evidence": { "type": "array", "items": { "type": "string" } }
      }
    },
    "decision": {
      "type": "object",
      "required": ["id", "question", "options", "status", "appliesTo", "effect"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "question": { "type": "string", "minLength": 1 },
        "options": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "status": { "enum": ["answered", "unanswered"] },
        "answer": { "type": "string" },
        "answerWording": { "type": "string" },
        "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "appliesTo": { "type": "string", "minLength": 1 },
        "effect": { "enum": ["binding", "run-only"] },
        "bindingDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    },
    "unresolved": {
      "type": "object",
      "required": ["id", "description", "readinessEffect"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "readinessEffect": { "enum": ["blocked", "incomplete"] }
      }
    }
  }
}

